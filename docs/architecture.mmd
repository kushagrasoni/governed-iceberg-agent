flowchart TB
    S1["<b>01 · Documents &amp; source tables</b><br/>generated loan applications · bank.transactions<br/><span class='ev'>evidence: source + file hash</span><br/><span class='mod'>datagen.py · docai.generate_documents</span>"]
    S2["<b>02 · Document AI</b><br/>extract · classify · confidence score per field<br/><span class='ev'>evidence: confidence per field</span><br/><span class='mod'>docai.extract · docai.route</span>"]
    RQ["<b>Reviewer queue</b><br/>fields below 0.90 confidence<br/>resolved by a named reviewer<br/><span class='mod'>gia review resolve</span>"]
    S3["<b>03 · Agentic pipeline</b><br/>LLM plans · tools act (PySpark, Trino in prod; DuckDB + PyIceberg here)<br/><span class='ev'>evidence: prompt · model ver · tool calls (OTel-style spans)</span><br/><span class='mod'>planners/ · plan.py · tracing.py</span>"]
    G["<b>Guardrails + pre-execution evals</b><br/>allowlist · no DROP · DELETE needs elevated · PII rules · blast radius<br/>dry run on Iceberg branch wap_&lt;plan&gt; · schema compat · DQ no-regression<br/><span class='mod'>policy.py · executor.dry_run · evals.py</span>"]
    S4["<b>04 · Human approval gate</b><br/>Agents propose. Humans approve.<br/><span class='ev gate'>evidence: approver · role · timestamp · decision</span><br/><span class='mod'>approval.py</span>"]
    S5["<b>05 · Iceberg lakehouse (on-prem)</b><br/>publish = main → evaluated snapshot · tag approved-&lt;plan&gt;<br/><span class='ev'>evidence: snapshot id · lineage · rollback pointer</span><br/><span class='mod'>executor.publish · gia rollback</span>"]
    X(["blocked or rejected<br/>branch discarded · main untouched"])
    AUD[("<b>Hash-chained audit log</b><br/>audit.jsonl + Iceberg governance.agent_audit<br/>Lineage · Provenance · Traces · Approvals")]

    S1 --> S2
    S2 -- "all fields ≥ 0.90" --> S3
    S2 -. "any field < 0.90" .-> RQ
    RQ -. "resolved" .-> S3
    S3 -- "JSON plan" --> G
    G -- "pass" --> S4
    G -. "deny / fail" .-> X
    S4 -. "reject / no answer" .-> X
    S4 -- "approve" --> S5
    S5 -- "evidence from every step" --> AUD

